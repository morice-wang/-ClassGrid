<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 链接抓取（内嵌教务系统网页）需要联网；无网络权限时 WebView 只会显示空白页 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- v1.45.0 常驻通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v1.47.4 自动更新：前台下载与安装 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/icon_opt4"
        android:roundIcon="@mipmap/icon_opt4"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ClassGrid">

        <receiver
            android:name=".TodayNotifyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.classgrid.app.action.TODAY_NOTIFY_REFRESH" />
                <action android:name="com.classgrid.app.action.TODAY_NOTIFY_OFF" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 桌面启动图标入口（可切换）：默认=最初紫色九宫格，其余 6 个可选，切换时只启用选中项。
             v1.25.0 起入口再次全部改用新组件名：旧组件（含被覆盖的启用状态）升级时失效，
             新装/升级后桌面立即显示默认紫色图标，不依赖桌面刷新 -->
        <activity-alias
            android:name=".LauncherPurple"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/icon_opt4"
            android:roundIcon="@mipmap/icon_opt4"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IcoAlt1"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_opt1"
            android:roundIcon="@mipmap/icon_opt1"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IcoAlt2"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_opt2"
            android:roundIcon="@mipmap/icon_opt2"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IcoAlt3"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_opt2a"
            android:roundIcon="@mipmap/icon_opt2a"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IcoAlt4"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_opt2b"
            android:roundIcon="@mipmap/icon_opt2b"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IcoAlt5"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_opt3"
            android:roundIcon="@mipmap/icon_opt3"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".IcoAlt6"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- v1.34.0 新增图标入口：极光主题配套（渐变底 + 四宫格）。默认关闭，设置页选图标时启用 -->
        <activity-alias
            android:name=".IcoAlt7"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_opt5"
            android:roundIcon="@mipmap/icon_opt5"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".CourseEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ImportActivity"
            android:exported="false" />

        <activity
            android:name=".OcrResultActivity"
            android:exported="false" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- 新手引导（v1.48.7）：一步一步的向导，首次安装/升级后第一次打开进入 -->
        <activity
            android:name=".OnboardingActivity"
            android:exported="false" />

        <!-- 课程列表：按星期列出某张课表的全部课程，点任意一门即可改（v1.36.0） -->
        <activity
            android:name=".CourseListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".BgCropActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".SectionTimeActivity"
            android:exported="false" />

        <activity
            android:name=".ScheduleProfilesActivity"
            android:exported="false" />

        <activity
            android:name=".TodoEditActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 选择学校：全国高校名单，搜索/按地区筛，网址可改（v1.38.0） -->
        <activity
            android:name=".SchoolPickerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".WebImportActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

            <!-- v1.44.0 桌面小组件：今天的课 -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.classgrid.app.action.WIDGET_REFRESH" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_today_info" />
        </receiver>

        <!-- v1.47.4 自动更新：前台下载服务 + 安装跳板 -->
        <service
            android:name=".UpdateService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".UpdateInstallActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
</application>

</manifest>
